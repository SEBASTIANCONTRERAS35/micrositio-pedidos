<!DOCTYPE html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Titulo estatico: el panel es SPA-lite, el JS hidrata negocio/usuario
         con el JWT de localStorage (no hay datos server-side en el render). -->
    <title>Pedidos — Panel ZUYU</title>
    <link rel="stylesheet" href="/css/panel.css" />
    <script defer src="/js/panel-pedidos.js"></script>
    <script defer src="/js/alpine.min.js"></script>
  </head>
  <body x-data="panelPedidos" x-init="loadPedidos(); setInterval(loadPedidos, 30000)">
    <header class="panel-header">
      <div class="panel-header__brand">
        <div
          class="panel-header__logo"
          x-text="negocio.nombre ? negocio.nombre.charAt(0) : 'M'"
        ></div>
        <h1 x-text="negocio.nombre || 'Panel'"></h1>
      </div>
      <div class="panel-header__user">
        <span class="panel-header__user-email" x-text="usuario.email"></span>
        <button class="panel-header__logout" @click="logout">Cerrar sesion</button>
      </div>
    </header>

    <main class="panel-main">
      <h1 class="panel-page-title">Pedidos</h1>
      <p class="panel-page-subtitle">
        Confirma, cancela y rastrea los pedidos online de tu negocio.
      </p>

      <nav class="panel-nav">
        <a href="/panel/pedidos" class="panel-nav__link panel-nav__link--active">Pedidos</a>
        <a href="/panel/integracion" class="panel-nav__link">Integración</a>
      </nav>

      <!-- Stats -->
      <div class="panel-stats">
        <div class="panel-stat">
          <p class="panel-stat__label">Pendientes</p>
          <p class="panel-stat__value panel-stat__value--orange" x-text="stats.pendientes"></p>
          <p class="panel-stat__delta">Necesitan tu confirmacion</p>
        </div>
        <div class="panel-stat">
          <p class="panel-stat__label">En camino</p>
          <p class="panel-stat__value panel-stat__value--blue" x-text="stats.enCamino"></p>
          <p class="panel-stat__delta">Repartidor asignado</p>
        </div>
        <div class="panel-stat">
          <p class="panel-stat__label">Entregados hoy</p>
          <p class="panel-stat__value panel-stat__value--green" x-text="stats.entregadosHoy"></p>
          <p class="panel-stat__delta">Pedidos completados</p>
        </div>
        <div class="panel-stat">
          <p class="panel-stat__label">Total hoy</p>
          <p class="panel-stat__value" x-text="'$' + stats.totalHoy.toFixed(2)"></p>
          <p class="panel-stat__delta">Ingresos del dia</p>
        </div>
      </div>

      <!-- Lista de pedidos -->
      <section class="panel-pedidos">
        <div class="panel-pedidos__header">
          <h2>Pedidos recientes</h2>
          <button @click="loadPedidos" class="panel-header__logout">↻ Refrescar</button>
        </div>

        <div class="panel-tabs">
          <template x-for="tab in tabs" :key="tab.value">
            <button
              class="panel-tab"
              :class="filter === tab.value ? 'panel-tab--active' : ''"
              @click="filter = tab.value"
            >
              <span x-text="tab.label"></span>
              <span class="panel-tab__count" x-text="countByStatus(tab.value)"></span>
            </button>
          </template>
        </div>

        <ul class="panel-pedido-list" x-show="filtered.length > 0">
          <template x-for="pedido in filtered" :key="pedido._id">
            <li class="panel-pedido" @click="openDetalle(pedido)">
              <span class="panel-pedido__id" x-text="pedido.pedidoId"></span>
              <span class="panel-pedido__info">
                <span class="panel-pedido__cliente" x-text="pedido.cliente.nombre"></span>
                <span class="panel-pedido__meta">
                  <span
                    x-text="pedido.productos.length + ' producto' + (pedido.productos.length > 1 ? 's' : '')"
                  ></span>
                  · <span x-text="formatTime(pedido.creadoEn)"></span>
                </span>
              </span>
              <span class="panel-pedido__total" x-text="'$' + pedido.total.toFixed(2)"></span>
              <span
                class="panel-pedido__estado"
                :class="'panel-pedido__estado--' + pedido.estado"
                x-text="estadoLabel(pedido.estado)"
              ></span>
            </li>
          </template>
        </ul>

        <div x-show="filtered.length === 0" class="panel-empty">
          <div class="panel-empty__icon">📦</div>
          <p>No hay pedidos en este estado.</p>
        </div>
      </section>
    </main>

    <!-- Modal de detalle -->
    <div x-show="selected" x-cloak class="modal-overlay" @click="selected = null">
      <div @click.stop class="pedido-detalle">
        <template x-if="selected">
          <div>
            <div class="pedido-detalle__header">
              <div>
                <h2 x-text="'Pedido ' + selected.pedidoId"></h2>
                <span
                  class="panel-pedido__estado"
                  :class="'panel-pedido__estado--' + selected.estado"
                  x-text="estadoLabel(selected.estado)"
                  style="margin-top: 8px"
                ></span>
              </div>
              <button class="pedido-detalle__close" @click="selected = null">×</button>
            </div>

            <div class="pedido-detalle__section">
              <h3>Cliente</h3>
              <p><strong x-text="selected.cliente.nombre"></strong></p>
              <p>
                📞
                <a
                  :href="'tel:' + selected.cliente.telefono"
                  x-text="selected.cliente.telefono"
                ></a>
              </p>
              <p>📧 <span x-text="selected.cliente.email"></span></p>
            </div>

            <div class="pedido-detalle__section">
              <h3>Direccion de entrega</h3>
              <p x-text="selected.cliente.direccion"></p>
            </div>

            <div class="pedido-detalle__section" x-show="selected.notas">
              <h3>Notas del cliente</h3>
              <p x-text="selected.notas"></p>
            </div>

            <div class="pedido-detalle__section">
              <h3>Productos</h3>
              <ul class="pedido-detalle__items">
                <template x-for="prod in selected.productos">
                  <li>
                    <span x-text="prod.cantidad + 'x ' + prod.nombre"></span>
                    <span x-text="'$' + (prod.precioUnitario * prod.cantidad).toFixed(2)"></span>
                  </li>
                </template>
              </ul>
              <p class="pedido-detalle__total" x-text="'Total: $' + selected.total.toFixed(2)"></p>
            </div>

            <template x-if="selected.delivery && selected.delivery.trackingUrl">
              <div class="pedido-detalle__section">
                <h3>Tracking del repartidor</h3>
                <p><a :href="selected.delivery.trackingUrl" target="_blank">Ver en vivo →</a></p>
              </div>
            </template>

            <div class="pedido-detalle__actions">
              <button
                x-show="selected.estado === 'pendiente'"
                @click="confirmar(selected.pedidoId)"
                class="btn-confirmar"
              >
                ✓ Confirmar pedido
              </button>
              <button
                x-show="['pendiente', 'confirmado'].includes(selected.estado)"
                @click="cancelar(selected.pedidoId)"
                class="btn-cancelar"
              >
                Cancelar
              </button>
              <button @click="selected = null" class="btn-cerrar">Cerrar</button>
            </div>
          </div>
        </template>
      </div>
    </div>
  </body>
</html>
