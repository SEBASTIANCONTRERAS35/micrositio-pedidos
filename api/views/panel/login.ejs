<!DOCTYPE html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login — Panel del negocio</title>
    <link rel="stylesheet" href="/css/panel.css" />
    <script defer src="/js/alpine.min.js"></script>
  </head>
  <body x-data="loginForm">
    <main class="login-main">
      <div class="login-card">
        <div class="login-card__logo">M</div>
        <h1>Panel del negocio</h1>
        <p class="login-card__subtitle">Ingresa para gestionar tus pedidos</p>

        <form @submit.prevent="submit">
          <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" x-model="email" required autocomplete="email" />
          </div>
          <div class="form-group">
            <label for="password">Contrasena</label>
            <input
              type="password"
              id="password"
              x-model="password"
              required
              autocomplete="current-password"
            />
          </div>

          <button type="submit" class="checkout-submit-btn" :disabled="submitting">
            <span x-show="!submitting">Entrar →</span>
            <span x-show="submitting" x-cloak>Entrando...</span>
          </button>

          <p x-show="error" x-cloak class="checkout-error" x-text="error"></p>
        </form>
      </div>
    </main>

    <script defer src="/js/panel-login.js"></script>
  </body>
</html>
