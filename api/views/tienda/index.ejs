<%
  const tipoMap = {
    'PHARMACY': 'Farmacia', 'RETAIL': 'Tienda', 'RESTAURANT': 'Restaurante',
    'CAFE': 'Cafe', 'GROCERY': 'Abarrotes', 'BAKERY': 'Panaderia',
    'OTHER': 'Negocio'
  };
  const tipoLabel = tipoMap[negocio.tipo] || 'Negocio';
  const inicial = negocio.nombre ? negocio.nombre.charAt(0).toUpperCase() : '?';
  const categoriaNames = Object.keys(porCategoria);
%>
<!DOCTYPE html>
<html lang="es-MX">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= negocio.nombre %> — Pedidos en linea</title>
  <meta name="description" content="<%= negocio.nombre %> — Catalogo de productos<% if (negocio.direccion && negocio.direccion.ciudad) { %> en <%= negocio.direccion.ciudad %><% } %>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap">
  <link rel="stylesheet" href="/css/tienda.css">
  <script defer src="/js/alpine.min.js"></script>
</head>
<body class="ct-page" x-data="cartStore('<%= negocio.slug %>')">

  <!-- STICKY HEADER -->
  <header class="ct-header" id="ct-top">
    <div class="ct-header__inner">
      <div class="ct-header__left">
        <div class="ct-header__logo" aria-hidden="true"><%= inicial %></div>
        <div class="ct-header__titles">
          <h1 class="ct-header__name"><%= negocio.nombre %></h1>
          <span class="ct-header__badge"><%= tipoLabel %></span>
        </div>
      </div>
      <div class="ct-header__right">
        <% if (negocio.telefono) { %>
        <a href="tel:<%= negocio.telefono %>" class="ct-header__phone">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.85 10.7 19.79 19.79 0 01.78 2.1 2 2 0 012.77 0h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L6.91 7.91a16 16 0 006.17 6.17l1.27-1.11a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
          <%= negocio.telefono %>
        </a>
        <% } %>
        <button @click="open = true" class="ct-cart-btn" aria-label="Abrir carrito">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 6H6"/></svg>
          <span class="ct-cart-btn__count" x-show="totalItems > 0" x-text="totalItems"></span>
        </button>
      </div>
    </div>
  </header>

  <!-- STICKY CATEGORY NAV -->
  <% if (categoriaNames.length > 0) { %>
  <nav class="ct-cat-nav" aria-label="Categorias">
    <div class="ct-cat-nav__inner">
      <a href="#ct-catalog" class="ct-cat-pill ct-cat-pill--all">Todos</a>
      <% categoriaNames.forEach((cat, i) => { %>
      <a href="#cat-<%= i %>" class="ct-cat-pill"><%= cat %></a>
      <% }); %>
    </div>
  </nav>
  <% } %>

  <!-- INFO BAR -->
  <% if (negocio.horarios || (negocio.direccion && negocio.direccion.ciudad)) { %>
  <div class="ct-info-bar">
    <div class="ct-info-bar__inner">
      <% if (negocio.horarios && negocio.horarios.apertura && negocio.horarios.cierre) { %>
      <span class="ct-info-bar__item">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12,6 12,12 16,14"/></svg>
        <%= negocio.horarios.apertura %> – <%= negocio.horarios.cierre %>
      </span>
      <% } %>
      <% if (negocio.direccion && negocio.direccion.ciudad) { %>
      <span class="ct-info-bar__item">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
        <%= [negocio.direccion.colonia, negocio.direccion.ciudad].filter(Boolean).join(', ') %>
      </span>
      <% } %>
    </div>
  </div>
  <% } %>

  <!-- PROMO BANNER -->
  <% if (promociones && promociones.length > 0) { %>
  <div class="ct-promo-banner">
    <div class="ct-promo-banner__inner">
      <span class="ct-promo-banner__label">Promociones activas:</span>
      <div class="ct-promo-banner__chips">
        <% for (const promo of promociones) { %>
        <span class="ct-promo-chip"><%= promo.nombre || promo.descripcion || 'Promocion activa' %></span>
        <% } %>
      </div>
    </div>
  </div>
  <% } %>

  <!-- MAIN CATALOG -->
  <main class="ct-main" id="ct-catalog">
    <div class="ct-main__inner">
      <% if (categoriaNames.length === 0) { %>
      <div class="ct-empty">
        <div class="ct-empty__icon">&#x1F6D2;</div>
        <p class="ct-empty__text">Este negocio aun no tiene productos publicados.</p>
        <p class="ct-empty__sub">Vuelve pronto.</p>
      </div>
      <% } else { %>
        <% categoriaNames.forEach((catNombre, ci) => { %>
        <section class="ct-section" id="cat-<%= ci %>">
          <div class="ct-section__header">
            <h2 class="ct-section__title"><%= catNombre %></h2>
            <span class="ct-section__count"><%= porCategoria[catNombre].length %> producto<%= porCategoria[catNombre].length !== 1 ? 's' : '' %></span>
          </div>
          <div class="ct-grid">
            <% for (const prod of porCategoria[catNombre]) { %>
            <article class="ct-card">
              <div class="ct-card__media">
                <% if (prod.imagen) { %>
                <img class="ct-card__img" src="<%= prod.imagen %>" alt="<%= prod.nombre %>" loading="lazy">
                <% } else { %>
                <div class="ct-card__placeholder">
                  <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.35"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21,15 16,10 5,21"/></svg>
                </div>
                <% } %>
                <% if (prod.stock === 0) { %>
                <div class="ct-card__out-badge">Agotado</div>
                <% } %>
              </div>
              <div class="ct-card__body">
                <p class="ct-card__name"><%= prod.nombre %></p>
                <div class="ct-card__footer">
                  <span class="ct-card__price">$<%= prod.precio.toFixed(2) %></span>
                  <% if (prod.stock > 0) { %>
                  <button
                    class="ct-card__add-btn"
                    @click="addToCart({ id: '<%= prod._id %>', nombre: '<%= prod.nombre %>', precio: <%= prod.precio %>, stock: <%= prod.stock %> })"
                    :disabled="getQuantity('<%= prod._id %>') >= <%= prod.stock %>">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    Agregar
                  </button>
                  <% } %>
                </div>
              </div>
            </article>
            <% } %>
          </div>
        </section>
        <% }); %>
      <% } %>
    </div>
  </main>

  <!-- CART DRAWER (Alpine.js) -->
  <div x-show="open" x-cloak class="ct-drawer-overlay" @click="open = false"></div>
  <aside x-show="open" x-cloak x-transition:enter.duration.300ms x-transition:leave.duration.200ms class="ct-drawer">
    <div class="ct-drawer__header">
      <h3>Tu pedido</h3>
      <button @click="open = false" class="ct-drawer__close" aria-label="Cerrar">&times;</button>
    </div>
    <div class="ct-drawer__body">
      <template x-if="items.length === 0">
        <p class="ct-drawer__empty">Tu carrito esta vacio</p>
      </template>
      <template x-for="item in items" :key="item.id">
        <div class="ct-drawer__item">
          <div class="ct-drawer__item-info">
            <p class="ct-drawer__item-name" x-text="item.nombre"></p>
            <p class="ct-drawer__item-price" x-text="'$' + item.precio.toFixed(2)"></p>
          </div>
          <div class="ct-drawer__item-qty">
            <button @click="decrement(item.id)">-</button>
            <span x-text="item.cantidad"></span>
            <button @click="increment(item.id)" :disabled="item.cantidad >= item.stock">+</button>
          </div>
        </div>
      </template>
    </div>
    <div class="ct-drawer__footer" x-show="items.length > 0">
      <div class="ct-drawer__total">
        <span>Total</span>
        <span class="ct-drawer__total-price" x-text="'$' + total.toFixed(2)"></span>
      </div>
      <a href="/tienda/<%= negocio.slug %>/checkout" class="ct-drawer__checkout-btn">
        Proceder al checkout
      </a>
    </div>
  </aside>

  <!-- FOOTER -->
  <footer class="ct-footer">
    <div class="ct-footer__inner">
      <% if (negocio.direccion) { %>
      <p class="ct-footer__address">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
        <%= [negocio.direccion.calle, negocio.direccion.colonia, negocio.direccion.ciudad, negocio.direccion.estado, negocio.direccion.cp ? 'C.P. ' + negocio.direccion.cp : null].filter(Boolean).join(', ') %>
      </p>
      <% } %>
      <% if (negocio.telefono) { %>
      <p class="ct-footer__phone">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.85 10.7 19.79 19.79 0 01.78 2.1 2 2 0 012.77 0h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L6.91 7.91a16 16 0 006.17 6.17l1.27-1.11a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
        <a href="tel:<%= negocio.telefono %>"><%= negocio.telefono %></a>
      </p>
      <% } %>
      <p class="ct-footer__powered">Pedidos via micrositio</p>
    </div>
  </footer>

  <script>
    // Cart store con localStorage por negocio
    function cartStore(slug) {
      const STORAGE_KEY = 'cart_' + slug;
      return {
        open: false,
        items: JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]'),
        get totalItems() { return this.items.reduce((sum, i) => sum + i.cantidad, 0); },
        get total() { return this.items.reduce((sum, i) => sum + (i.precio * i.cantidad), 0); },
        save() { localStorage.setItem(STORAGE_KEY, JSON.stringify(this.items)); },
        addToCart(prod) {
          const existing = this.items.find(i => i.id === prod.id);
          if (existing) {
            if (existing.cantidad < prod.stock) existing.cantidad += 1;
          } else {
            this.items.push({ ...prod, cantidad: 1 });
          }
          this.save();
        },
        increment(id) {
          const item = this.items.find(i => i.id === id);
          if (item && item.cantidad < item.stock) item.cantidad += 1;
          this.save();
        },
        decrement(id) {
          const item = this.items.find(i => i.id === id);
          if (item) {
            item.cantidad -= 1;
            if (item.cantidad <= 0) this.items = this.items.filter(i => i.id !== id);
          }
          this.save();
        },
        getQuantity(id) {
          const item = this.items.find(i => i.id === id);
          return item ? item.cantidad : 0;
        }
      };
    }

    // Smooth scroll
    document.querySelectorAll('.ct-cat-pill[href^="#cat-"], .ct-cat-pill--all').forEach(function(pill) {
      pill.addEventListener('click', function(e) {
        const target = document.querySelector(this.getAttribute('href'));
        if (target) {
          e.preventDefault();
          const offset = 120;
          const top = target.getBoundingClientRect().top + window.scrollY - offset;
          window.scrollTo({ top: top, behavior: 'smooth' });
        }
      });
    });
  </script>

</body>
</html>
