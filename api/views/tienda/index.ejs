<% const tipoMap = { 'PHARMACY': 'Farmacia', 'RETAIL': 'Tienda', 'RESTAURANT': 'Restaurante',
'CAFE': 'Cafe', 'GROCERY': 'Abarrotes', 'BAKERY': 'Panaderia', 'OTHER': 'Negocio' }; const tipoLabel
= tipoMap[negocio.tipo] || 'Negocio'; const inicial = negocio.nombre ?
negocio.nombre.charAt(0).toUpperCase() : '?'; const categoriaNames = Object.keys(porCategoria); %>
<!DOCTYPE html>
<html lang="es-MX" data-type="<%= negocio.tipo %>">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= negocio.nombre %> — Pedidos en linea</title>
    <meta
      name="description"
      content="<%= negocio.nombre %> — Catalogo<% if (negocio.direccion && negocio.direccion.ciudad) { %> en <%= negocio.direccion.ciudad %><% } %>. Pide en linea con entrega a domicilio."
    />
    <meta name="theme-color" content="#0F172A" />
    <link rel="stylesheet" href="/css/tienda.css" />
    <script defer src="/js/alpine.min.js"></script>
  </head>
  <body data-type="<%= negocio.tipo %>" x-data="cartStore('<%= negocio.slug %>')">
    <!-- HEADER -->
    <header class="ct-header" id="ct-top">
      <div class="ct-header__inner">
        <div class="ct-header__left">
          <div class="ct-header__logo" aria-hidden="true"><%= inicial %></div>
          <div class="ct-header__titles">
            <h1 class="ct-header__name"><%= negocio.nombre %></h1>
            <span class="ct-header__badge"><%= tipoLabel %></span>
          </div>
        </div>
        <div class="ct-header__right">
          <% if (negocio.telefono) { %>
          <a href="tel:<%= negocio.telefono %>" class="ct-header__phone">
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.85 10.7 19.79 19.79 0 01.78 2.1 2 2 0 012.77 0h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L6.91 7.91a16 16 0 006.17 6.17l1.27-1.11a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"
              />
            </svg>
            <%= negocio.telefono %>
          </a>
          <% } %>
          <button @click="open = true" class="ct-cart-btn" aria-label="Abrir carrito">
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="9" cy="21" r="1" />
              <circle cx="20" cy="21" r="1" />
              <path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 6H6" />
            </svg>
            <span x-show="totalItems === 0" x-cloak>Carrito</span>
            <span
              x-show="totalItems > 0"
              x-cloak
              class="ct-cart-btn__count"
              x-text="totalItems"
            ></span>
          </button>
        </div>
      </div>
    </header>

    <!-- CATEGORY NAV -->
    <% if (categoriaNames.length > 0) { %>
    <nav class="ct-cat-nav" aria-label="Categorias">
      <div class="ct-cat-nav__inner">
        <a href="#ct-catalog" class="ct-cat-pill ct-cat-pill--all">Todos</a>
        <% categoriaNames.forEach((cat, i) => { %>
        <a href="#cat-<%= i %>" class="ct-cat-pill"><%= cat %></a>
        <% }); %>
      </div>
    </nav>
    <% } %>

    <!-- INFO BAR -->
    <% if (negocio.horarios || (negocio.direccion && negocio.direccion.ciudad)) { %>
    <div class="ct-info-bar">
      <div class="ct-info-bar__inner">
        <% if (negocio.horarios && negocio.horarios.apertura && negocio.horarios.cierre) { %>
        <span class="ct-info-bar__item">
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="12" cy="12" r="10" />
            <polyline points="12,6 12,12 16,14" />
          </svg>
          Abierto · <%= negocio.horarios.apertura %>–<%= negocio.horarios.cierre %>
        </span>
        <% } %> <% if (negocio.direccion && negocio.direccion.ciudad) { %>
        <span class="ct-info-bar__item">
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z" />
            <circle cx="12" cy="10" r="3" />
          </svg>
          <%= [negocio.direccion.colonia, negocio.direccion.ciudad].filter(Boolean).join(', ') %>
        </span>
        <% } %>
        <span class="ct-info-bar__item" style="margin-left: auto">
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="1" y="3" width="15" height="13" rx="2" />
            <polygon points="16 8 20 8 23 11 23 16 16 16 16 8" />
            <circle cx="5.5" cy="18.5" r="2.5" />
            <circle cx="18.5" cy="18.5" r="2.5" />
          </svg>
          Entrega a domicilio
        </span>
      </div>
    </div>
    <% } %>

    <!-- PROMO BANNER -->
    <% if (promociones && promociones.length > 0) { %>
    <div class="ct-promo-banner">
      <div class="ct-promo-banner__inner">
        <span class="ct-promo-banner__label">Promociones</span>
        <div class="ct-promo-banner__chips">
          <% for (const promo of promociones) { %>
          <span class="ct-promo-chip"
            ><%= promo.nombre || promo.descripcion || 'Promocion activa' %></span
          >
          <% } %>
        </div>
      </div>
    </div>
    <% } %>

    <!-- MAIN CATALOG -->
    <main class="ct-main" id="ct-catalog">
      <div class="ct-main__inner">
        <% if (categoriaNames.length === 0) { %>
        <div class="ct-empty">
          <div class="ct-empty__icon">🛒</div>
          <p class="ct-empty__text">Aun no hay productos publicados</p>
          <p class="ct-empty__sub">Vuelve pronto.</p>
        </div>
        <% } else { %> <% categoriaNames.forEach((catNombre, ci) => { %>
        <section class="ct-section" id="cat-<%= ci %>">
          <div class="ct-section__header">
            <h2 class="ct-section__title"><%= catNombre %></h2>
            <span class="ct-section__count"
              ><%= porCategoria[catNombre].length %> producto<%= porCategoria[catNombre].length !==
              1 ? 's' : '' %></span
            >
          </div>
          <div class="ct-grid">
            <% for (const prod of porCategoria[catNombre]) { %> <%# stock null/undefined = producto
            no trackeado en ZUYU = stock ilimitado (vendible). Solo es "agotado" si es un numero <=
            0. %> <% const sinLimite = prod.stock === null || prod.stock === undefined; %> <% const
            stockNum = sinLimite ? 9999 : prod.stock; %> <% const agotado = !sinLimite && prod.stock
            <= 0; %> <% const stockBajo = !sinLimite && prod.stock > 0 && prod.stock <= 5; %>
            <article class="ct-card">
              <div class="ct-card__media">
                <% if (prod.imagen) { %>
                <img
                  class="ct-card__img"
                  src="<%= prod.imagen %>"
                  alt="<%= prod.nombre %>"
                  loading="lazy"
                />
                <% } else { %>
                <div class="ct-card__placeholder">
                  <svg
                    width="40"
                    height="40"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                  >
                    <rect x="3" y="3" width="18" height="18" rx="2" />
                    <circle cx="8.5" cy="8.5" r="1.5" />
                    <polyline points="21,15 16,10 5,21" />
                  </svg>
                </div>
                <% } %> <% if (agotado) { %>
                <div class="ct-card__out-badge">Agotado</div>
                <% } else if (stockBajo) { %>
                <div class="ct-card__low-badge">Solo <%= prod.stock %></div>
                <% } %>
              </div>
              <div class="ct-card__body">
                <p class="ct-card__name"><%= prod.nombre %></p>
                <div class="ct-card__footer">
                  <span class="ct-card__price">$<%= prod.precio.toFixed(2) %></span>
                  <% if (!agotado) { %>
                  <!-- Si no esta en carrito: boton +. Si ya esta: control de cantidad -->
                  <template x-if="getQuantity('<%= prod._id %>') === 0">
                    <%# Datos del producto via data-* (JSON.stringify + escape EJS) en vez de
                    interpolar en un string JS — evita XSS si el nombre del producto trae
                    comillas/scripts. %>
                    <button
                      class="ct-card__add-btn"
                      data-producto="<%= JSON.stringify({ id: String(prod._id), nombre: prod.nombre, precio: prod.precio, stock: stockNum }) %>"
                      @click="addProduct($el)"
                      aria-label="Agregar al carrito"
                    >
                      <svg
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="3"
                        stroke-linecap="round"
                      >
                        <line x1="12" y1="5" x2="12" y2="19" />
                        <line x1="5" y1="12" x2="19" y2="12" />
                      </svg>
                    </button>
                  </template>
                  <template x-if="getQuantity('<%= prod._id %>') > 0">
                    <div class="ct-card__qty-control">
                      <button
                        class="ct-card__qty-btn"
                        @click="decrement('<%= prod._id %>')"
                        aria-label="Quitar"
                      >
                        −
                      </button>
                      <span class="ct-card__qty-num" x-text="getQuantity('<%= prod._id %>')"></span>
                      <button
                        class="ct-card__qty-btn"
                        @click="increment('<%= prod._id %>')"
                        :disabled="getQuantity('<%= prod._id %>') >= <%= stockNum %>"
                        aria-label="Agregar"
                      >
                        +
                      </button>
                    </div>
                  </template>
                  <% } %>
                </div>
              </div>
            </article>
            <% } %>
          </div>
        </section>
        <% }); %> <% } %>
      </div>
    </main>

    <!-- CART DRAWER -->
    <div
      x-show="open"
      x-cloak
      class="ct-drawer-overlay"
      @click="open = false"
      x-transition.opacity
    ></div>
    <aside
      x-show="open"
      x-cloak
      x-transition:enter="transition ease-out duration-300"
      x-transition:enter-start="translate-x-full"
      x-transition:enter-end="translate-x-0"
      class="ct-drawer"
    >
      <div class="ct-drawer__header">
        <h3>
          Tu pedido
          <span
            x-show="totalItems > 0"
            x-cloak
            style="color: var(--text-3); font-weight: 500"
            x-text="'(' + totalItems + ')'"
          ></span>
        </h3>
        <button @click="open = false" class="ct-drawer__close" aria-label="Cerrar">×</button>
      </div>
      <div class="ct-drawer__body">
        <template x-if="items.length === 0">
          <p class="ct-drawer__empty">Tu carrito esta vacio.<br />Agrega productos para empezar.</p>
        </template>
        <template x-for="item in items" :key="item.id">
          <div class="ct-drawer__item">
            <div class="ct-drawer__item-info">
              <p class="ct-drawer__item-name" x-text="item.nombre"></p>
              <p class="ct-drawer__item-price" x-text="'$' + item.precio.toFixed(2) + ' c/u'"></p>
            </div>
            <div class="ct-drawer__item-qty">
              <button @click="decrement(item.id)" aria-label="Quitar">−</button>
              <span x-text="item.cantidad"></span>
              <button
                @click="increment(item.id)"
                :disabled="item.cantidad >= item.stock"
                aria-label="Agregar"
              >
                +
              </button>
            </div>
          </div>
        </template>
      </div>
      <div class="ct-drawer__footer" x-show="items.length > 0" x-cloak>
        <div class="ct-drawer__total">
          <span>Total</span>
          <span class="ct-drawer__total-price" x-text="'$' + total.toFixed(2)"></span>
        </div>
        <a href="/tienda/<%= negocio.slug %>/checkout" class="ct-drawer__checkout-btn">
          Proceder al checkout
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="5" y1="12" x2="19" y2="12" />
            <polyline points="12 5 19 12 12 19" />
          </svg>
        </a>
      </div>
    </aside>

    <!-- TOAST -->
    <div
      x-show="toastMessage"
      x-cloak
      class="ct-toast"
      x-transition.opacity
      x-text="toastMessage"
    ></div>

    <!-- FOOTER -->
    <footer class="ct-footer">
      <div class="ct-footer__inner">
        <% if (negocio.direccion) { %>
        <p class="ct-footer__address">
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z" />
            <circle cx="12" cy="10" r="3" />
          </svg>
          <%= [negocio.direccion.calle, negocio.direccion.colonia, negocio.direccion.ciudad,
          negocio.direccion.estado, negocio.direccion.cp ? 'C.P. ' + negocio.direccion.cp :
          null].filter(Boolean).join(', ') %>
        </p>
        <% } %> <% if (negocio.telefono) { %>
        <p class="ct-footer__phone">
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path
              d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.85 10.7 19.79 19.79 0 01.78 2.1 2 2 0 012.77 0h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L6.91 7.91a16 16 0 006.17 6.17l1.27-1.11a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"
            />
          </svg>
          <a href="tel:<%= negocio.telefono %>"><%= negocio.telefono %></a>
        </p>
        <% } %>
        <p class="ct-footer__powered">Pedidos en linea via micrositio</p>
      </div>
    </footer>

    <script defer src="/js/tienda.js"></script>
  </body>
</html>
