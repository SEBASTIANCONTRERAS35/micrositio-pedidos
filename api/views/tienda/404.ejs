<!DOCTYPE html>
<html lang="es-MX">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pagina no encontrada</title>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap">
  <style>
    body { font-family: 'Inter', sans-serif; background: #F8FAFC; min-height: 100vh; display: flex; align-items: center; justify-content: center; margin: 0; }
    .empty { text-align: center; max-width: 400px; padding: 40px; }
    .empty__icon { font-size: 64px; margin-bottom: 16px; }
    .empty h1 { color: #0F172A; margin: 0 0 8px; font-size: 24px; }
    .empty p { color: #64748B; margin: 0; }
  </style>
</head>
<body>
  <div class="empty">
    <div class="empty__icon">&#x1F50D;</div>
    <h1>Pagina no encontrada</h1>
    <p><%= mensaje %></p>
  </div>
</body>
</html>
