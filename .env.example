# ═══════════════════════════════════════════════════════════════════
# Micrositio de Pedidos — Variables de entorno
# Copia este archivo a .env y completa los valores
# ═══════════════════════════════════════════════════════════════════

# ── Application ────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ── MongoDB (Replica Set) ──────────────────────────────────────────
# Local con docker-compose:
MONGODB_URI=mongodb://app:devpassword@mongodb:27017/micrositio?replicaSet=rs0&authSource=admin
# Producción K8s (ejemplo):
# MONGODB_URI=mongodb://app:$PASS@mongodb-0.mongodb-headless.micrositio.svc:27017,mongodb-1.mongodb-headless.micrositio.svc:27017,mongodb-2.mongodb-headless.micrositio.svc:27017/micrositio?replicaSet=rs0&authSource=admin

# ── Redis ──────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=devpassword

# ── JWT (RS256) ────────────────────────────────────────────────────
# Generar par con: openssl genrsa -out jwt-private.pem 2048 && openssl rsa -in jwt-private.pem -pubout -out jwt-public.pem
JWT_PRIVATE_KEY_PATH=/secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=/secrets/jwt-public.pem
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d

# ── Notificaciones ─────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=pedidos@zuyu.local

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Delivery Carriers ──────────────────────────────────────────────
# Para desarrollo, todos pueden estar en mock excepto iVoy
DELIVERY_DEFAULT_PROVIDER=ivoy

# iVoy (sandbox publico)
IVOY_USER=integracion-express@ivoy.mx
IVOY_PASSWORD=sandbox
IVOY_BASE_URL=https://sandbox.ivoy.mx/api
IVOY_MOCK=false

# Lalamove (en desarrollo se usa mock)
LALAMOVE_API_KEY=
LALAMOVE_API_SECRET=
LALAMOVE_BASE_URL=https://rest.sandbox.lalamove.com/v3
LALAMOVE_MOCK=true

# Uber Direct (en desarrollo se usa mock)
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=
UBER_CUSTOMER_ID=
UBER_BASE_URL=https://api.uber.com/v1
UBER_MOCK=true

# ── Webhook Secrets (HMAC verification) ────────────────────────────
WEBHOOK_SECRET_IVOY=
WEBHOOK_SECRET_LALAMOVE=
WEBHOOK_SECRET_UBER=
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300

# ── Integracion con ZUYU (Fase 4.5) ────────────────────────────────
# En MOCK = true, el micrositio usa su propio MongoDB local (modo standalone)
# En produccion = false, sincroniza con ZUYU via API + webhooks
ZUYU_MOCK=true
ZUYU_BASE_URL=https://api.zuyu.mx
ZUYU_TIMEOUT_MS=8000
# API key generada desde el panel de ZUYU (formato zk_<env>_<...>)
ZUYU_API_KEY=
# Secret HMAC para verificar webhooks entrantes de ZUYU (estilo Stripe:
# ZUYU firma `${timestamp}.${body}` y manda header X-Zuyu-Signature)
ZUYU_WEBHOOK_SECRET=
# Durante rotacion del secret, el anterior sigue valido (dual-secret)
ZUYU_WEBHOOK_SECRET_PREVIO=

# ── Rate Limiting ──────────────────────────────────────────────────
RATE_LIMIT_PUBLIC_POINTS=100
RATE_LIMIT_PUBLIC_DURATION=60
RATE_LIMIT_WEBHOOK_POINTS=200
RATE_LIMIT_WEBHOOK_DURATION=60
